# ============================================================
# NYXOSHI V12 — ENVIRONMENT VARIABLES
# ============================================================
# Nunca coloque valores reais/secrets no repositório público.
# Configure os valores reais no Vercel Project > Settings > Environment Variables.

# -------------------------
# DATABASE / PERSISTENCE
# -------------------------
# PostgreSQL de produção. Obrigatório no Vercel para persistência real.
DATABASE_URL=

# -------------------------
# BETTER AUTH / CANONICAL URL
# -------------------------
# URL pública principal do Nyxoshi, sem barra no final.
BETTER_AUTH_URL=https://SEU-DOMINIO

# Segredo longo e aleatório. Gere um valor novo e privado para produção.
BETTER_AUTH_SECRET=

# URL usada pelo Capacitor/mobile e como referência pública da aplicação.
NYXOSHI_APP_URL=https://SEU-DOMINIO

# -------------------------
# NYXOSHI — FUNDAÇÃO
# -------------------------
# Os três fundadores ORIGINAIS são definidos exclusivamente por e-mail.
NYXOSHI_FOUNDER_1_EMAIL=
NYXOSHI_FOUNDER_2_EMAIL=
NYXOSHI_FOUNDER_3_EMAIL=

# -------------------------
# NYXOSHI — CARGOS ESPECIAIS
# -------------------------
# Angel Girl: cargo isolado com os privilégios administrativos especiais.
NYXOSHI_ANGEL_GIRL_EMAIL=

# Supremo Arquimago: cargo especial um nível abaixo dos Fundadores.
NYXOSHI_SUPREME_ARCHMAGE_EMAIL=

# Maluco Cientista de Hardware com Farofa: exatamente uma conta.
# Dá acesso somente ao Laboratório da Maluca, não ao painel administrativo.
NYXOSHI_HARDWARE_SCIENTIST_EMAIL=

# IMPORTANTE:
# Sub Fundadores/Vice Fundadores e autorizados do painel de denúncias
# são vinculados por ID permanente no banco de dados, não por variável de ambiente.

# -------------------------
# AUTH / BROKER
# -------------------------
# Em ambientes gerenciados pelo App Builder/deployer, estas variáveis podem
# ser injetadas automaticamente. No Vercel independente, configure-as somente
# se sua infraestrutura de autenticação fornecer esses valores.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=

# -------------------------
# CONNECTORS (quando utilizados pela infraestrutura do app)
# -------------------------
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# -------------------------
# CLIENT / PWA
# -------------------------
# Deve permanecer true na versão Beta publicada.
VITE_AUTH_ENABLED=true

# Host público usado pelo gerador PWA/OG quando fornecido pela infraestrutura.
# Normalmente não é necessário preencher manualmente se o deployer fornecer.
VITE_PUBLIC_HOSTNAME=

# ============================================================
# VARIÁVEIS GERENCIADAS PELO VERCEL — NÃO CADASTRE MANUALMENTE
# ============================================================
# VERCEL_URL
# VERCEL_BRANCH_URL
# VERCEL_PROJECT_PRODUCTION_URL
# NODE_ENV
# O Vercel fornece essas variáveis automaticamente quando habilitadas.

# ============================================================
# VARIÁVEIS SOMENTE PARA SCRIPTS/TESTES LOCAIS
# ============================================================
# BROWSER_ALLOW_EXTERNAL_HOST=1
# PREVIEW_READY_TIMEOUT_MS=60000
# PREVIEW_THUMBNAIL_TIMEOUT_MS=60000
# BROWSER_SMOKE_TIMEOUT_MS=30000
# Use somente quando necessário para desenvolvimento/testes.
